id = "{{.ProjectId}}"
version = "0.1.0"
js-sdk-version = "{{.JsSdkVersion}}"

{{if ne .DistributionDir .DefaultDistributionDir}}
distribution-dir = "{{.DistributionDir}}"
{{end}}

{{if ne .SourceDir .DefaultSourceDir}}
source-dir = "{{.SourceDir}}"
{{end}}

[[command]]
name = "install"
command = "npm install"

# Used by `mugon dev`: no LTO, so it rebuilds quickly on every save.
[[command]]
name = "build"
scope = "dev"
command = "cargo build --release --target wasm32-unknown-unknown && wasm-bindgen --target web --no-typescript --out-dir pkg --out-name game target/wasm32-unknown-unknown/release/game.wasm && npm run build"

# Used by `mugon publish`: full LTO, much slower to compile.
[[command]]
name = "build"
command = "cargo build --profile release-lto --target wasm32-unknown-unknown && wasm-bindgen --target web --no-typescript --out-dir pkg --out-name game target/wasm32-unknown-unknown/release-lto/game.wasm && npm run build"
